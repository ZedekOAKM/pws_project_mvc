<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upravit akci | EventZone</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <div style="max-width: 600px; margin: 60px auto; padding: 35px; background: #1a1a1a; border-radius: 12px; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
        <div style="margin-bottom: 25px;">
            <a href="/events" style="color: #888; text-decoration: none; font-size: 14px;">← Zpět na seznam akcí</a>
            <h2 style="color: #deff9a; margin-top: 15px; margin-bottom: 0; font-size: 28px; letter-spacing: 1px;">Upravit akci</h2>
            <p style="color: #666; font-size: 14px; margin-top: 5px;">Zde můžete změnit detaily již existující akce.</p>
        </div>

        <form action="/events/<%= event._id %>/edit" method="POST" enctype="multipart/form-data">
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Název akce</label>
                <input type="text" name="title" value="<%= event.title %>" required 
                       style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Popis akce</label>
                <textarea name="description" required rows="4"
                          style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px; resize: vertical; font-family: inherit;"><%= event.description %></textarea>
            </div>

            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Datum konání</label>
                    <input type="date" name="date" value="<%= new Date(event.date).toISOString().split('T')[0] %>" required 
                           style="width: 100%; padding: 11px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
                </div>
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Maximální kapacita</label>
                    <input type="number" name="maxAttendees" value="<%= event.maxAttendees %>" required 
                           style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Místo konání</label>
                <select name="location" required 
                        style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px; cursor: pointer;">
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc._id %>" <%= event.location && event.location.toString() === loc._id.toString() ? 'selected' : '' %> style="background: #1a1a1a;">
                            <%= loc.name %> (<%= loc.city %>)
                        </option>
                    <% }) %>
                </select>
            </div>

            <div style="margin-bottom: 35px; background: #222; padding: 15px; border-radius: 6px; border: 1px dashed #444;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px; font-weight: bold;">Změnit plakát (volitelné)</label>
                <p style="color: #666; font-size: 12px; margin-top: 0; margin-bottom: 10px;">Pokud nevyberete žádný soubor, zůstane zachován stávající obrázek.</p>
                <input type="file" name="image" accept="image/*" style="color: #888; font-size: 14px; width: 100%;">
            </div>

            <button type="submit" style="width: 100%; padding: 14px; background: #deff9a; color: #121212; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 16px;">
                Uložit provedené změny
            </button>
        </form>
    </div>
</body>
</html>