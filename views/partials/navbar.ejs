<style>
    /* Moderní temný design pro EventZone */
    body {
        background-color: #121212;
        color: #e0e0e0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin: 0;
        padding-top: 70px; /* Aby nám menu nepřekrývalo obsah */
    }
    .navbar {
        background-color: #1a1a1a;
        border-bottom: 1px solid #333;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 30px;
        height: 60px;
        z-index: 1000;
    }
    .navbar-brand {
        color: #deff9a;
        font-size: 24px;
        font-weight: bold;
        text-decoration: none;
        letter-spacing: 1px;
    }
    .navbar-links {
        display: flex;
        gap: 20px;
        align-items: center;
    }
    .navbar-links a {
        color: #b0b0b0;
        text-decoration: none;
        font-size: 16px;
        transition: color 0.2s;
    }
    .navbar-links a:hover {
        color: #deff9a;
    }
    .btn-auth {
        background-color: #deff9a;
        color: #121212 !important;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: bold;
    }
    .btn-auth:hover {
        background-color: #c5eb7f !important;
    }
    .user-info {
        font-size: 14px;
        color: #888;
        border-right: 1px solid #333;
        padding-right: 15px;
    }
</style>

<nav class="navbar">
    <a href="/" class="navbar-brand">EVENTZONE 🚀</a>
    <div class="navbar-links">
        <a href="/events">Akce</a>
        <a href="/locations">Místa konání</a>

        <% if (locals.user && (user.role === 'admin' || user.role === 'organizator')) { %>
            <a href="/events/add" style="color: #ffca28;">+ Vytvořit akci</a>
            <a href="/locations/add" style="color: #ffca28;">+ Přidat místo</a>
        <% } %>

        <% if (locals.user) { %>
            <span class="user-info">Uživatel: <strong><%= user.username %></strong> (<%= user.role %>)</span>
            
            <% if (user.role === 'admin') { %>
                <a href="/admin/users" style="color: #ffca28; text-decoration: none; font-weight: bold;">
                    ⚙️ Správa uživatelů
                </a>
            <% } %>

            <a href="/logout">Odhlásit se</a>
        <% } else { %>
            <a href="/login">Přihlášení</a>
            <a href="/register" class="btn-auth">Registrace</a>
        <% } %>

        <% if (locals.notification) { %>
            <div id="toast-notification" style="
                position: fixed;
                bottom: 25px;
                right: 25px;
                background: <%= notification.type === 'success' ? '#1b5e20' : (notification.type === 'error' ? '#b71c1c' : '#212121') %>;
                color: #fff;
                border: 1px solid <%= notification.type === 'success' ? '#deff9a' : (notification.type === 'error' ? '#ff8a80' : '#444') %>;
                padding: 16px 24px;
                border-radius: 8px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.5);
                z-index: 1000;
                font-weight: bold;
                display: flex;
                align-items: center;
                gap: 10px;
                animation: slideIn 0.3s ease-out;
            ">
                <%= notification.text %>
            </div>

            <script>
                setTimeout(() => {
                    const toast = document.getElementById('toast-notification');
                    if (toast) {
                        toast.style.transition = 'opacity 0.5s ease-out, transform 0.5s ease-out';
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateY(20px)';
                        setTimeout(() => toast.remove(), 500);
                    }
                }, 4000);
            </script>

            <style>
                @keyframes slideIn {
                    from { transform: translateY(50px); opacity: 0; }
                    to { transform: translateY(0); opacity: 1; }
                }
            </style>
        <% } %>
    </div>
</nav>