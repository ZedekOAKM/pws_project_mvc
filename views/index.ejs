<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EventZone | Najdi svůj příští zážitek</title>
</head>
<body style="background-color: #0c0c0c; color: #fff; font-family: sans-serif; margin: 0;">

    <%- include('partials/navbar') %>

    <!-- Slider -->
    <div style="position: relative; width: 100%; height: 500px; overflow: hidden; margin-bottom: 60px;">
        <div id="slider-container" style="display: flex; width: 100%; height: 100%; transition: transform 0.5s ease-in-out;">
            <div class="slider-slide" style="min-width: 100%; height: 100%; background-image: url('/uploads/pexels-audience-1850022.jpg'); background-size: cover; background-position: center;"></div>
            <div class="slider-slide" style="min-width: 100%; height: 100%; background-image: url('/uploads/pexels-audience-1867754.jpg'); background-size: cover; background-position: center;"></div>
            <div class="slider-slide" style="min-width: 100%; height: 100%; background-image: url('/uploads/pexels-audience-1868137.jpg'); background-size: cover; background-position: center;"></div>
        </div>

        <!-- Overlay for text readability -->
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.4);"></div>

        <!-- Previous/Next buttons -->
        <button id="prev-btn" onclick="changeSlide(-1)" style="position: absolute; left: 20px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.3); border: none; color: #fff; font-size: 28px; padding: 12px 18px; border-radius: 6px; cursor: pointer; z-index: 10; transition: background 0.2s;">‹</button>
        <button id="next-btn" onclick="changeSlide(1)" style="position: absolute; right: 20px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.3); border: none; color: #fff; font-size: 28px; padding: 12px 18px; border-radius: 6px; cursor: pointer; z-index: 10; transition: background 0.2s;">›</button>

        <!-- Dots indicator -->
        <div style="position: absolute; bottom: 15px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px; z-index: 10;">
            <span class="dot" onclick="currentSlide(0)" style="width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.6); cursor: pointer; transition: background 0.2s;"></span>
            <span class="dot" onclick="currentSlide(1)" style="width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.6); cursor: pointer; transition: background 0.2s;"></span>
            <span class="dot" onclick="currentSlide(2)" style="width: 12px; height: 12px; border-radius: 50%; background: rgba(255,255,255,0.6); cursor: pointer; transition: background 0.2s;"></span>
        </div>
    </div>

    <script>
        let currentSlideIndex = 0;
        const totalSlides = 3;

        function changeSlide(n) {
            currentSlideIndex += n;
            if (currentSlideIndex >= totalSlides) currentSlideIndex = 0;
            if (currentSlideIndex < 0) currentSlideIndex = totalSlides - 1;
            updateSlider();
        }

        function currentSlide(n) {
            currentSlideIndex = n;
            updateSlider();
        }

        function updateSlider() {
            const container = document.getElementById('slider-container');
            container.style.transform = `translateX(-${currentSlideIndex * 100}%)`;

            const dots = document.querySelectorAll('.dot');
            dots.forEach((dot, index) => {
                dot.style.background = index === currentSlideIndex ? 'rgba(255,255,255,1)' : 'rgba(255,255,255,0.6)';
            });
        }

        // Auto-advance slide every 5 seconds
        setInterval(() => {
            changeSlide(1);
        }, 5000);

        updateSlider();
    </script>

    <div style="max-width: 1000px; margin: 0 auto; padding: 100px 20px 60px 20px; text-align: center;">
        <h1 style="color: #fff; font-size: 72px; font-weight: 800; margin-bottom: 20px; letter-spacing: -1px;">
            Najdi svůj příští <span style="color: #deff9a;">zážitek 🚀</span>
        </h1>
        <p style="color: #aaa; font-size: 24px; max-width: 650px; margin: 0 auto 40px auto; line-height: 1.6;">
            Vítej na EventZone. Platformě pro objevování, plánování a správu nejlepších festivalů, koncertů a komunitních akcí ve tvém okolí.
        </p>
        
        <a href="/events" style="display: inline-block; background-color: #deff9a; color: #121212; padding: 15px 35px; text-decoration: none; border-radius: 30px; font-weight: bold; font-size: 16px; box-shadow: 0 4px 15px rgba(222,255,154,0.2); transition: transform 0.2s;">
            Prohlížet akce
        </a>
    </div>

    <div style="max-width: 1000px; margin: 0 auto 80px auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between;">
        <div style="background: #161616; border: 1px solid #222; border-radius: 12px; padding: 25px; flex: 1; min-width: 250px; text-align: center;">
            <div style="font-size: 36px; font-weight: bold; color: #ffca28; margin-bottom: 5px;">100%</div>
            <div style="color: #888; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Dostupné online rezervace</div>
        </div>
        <div style="background: #161616; border: 1px solid #222; border-radius: 12px; padding: 25px; flex: 1; min-width: 250px; text-align: center;">
            <div style="font-size: 36px; font-weight: bold; color: #deff9a; margin-bottom: 5px;">Top lokality</div>
            <div style="color: #888; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Kluby, haly i open-airy</div>
        </div>
        <div style="background: #161616; border: 1px solid #222; border-radius: 12px; padding: 25px; flex: 1; min-width: 250px; text-align: center;">
            <div style="font-size: 36px; font-weight: bold; color: #fff; margin-bottom: 5px;">Rychlý přehled</div>
            <div style="color: #888; font-size: 14px; text-transform: uppercase; letter-spacing: 1px;">Správa profilu a rolí</div>
        </div>
    </div>

    <div style="background-color: #111; border-top: 1px solid #222; padding: 60px 0;">
        <div style="max-width: 1000px; margin: 0 auto; padding: 0 20px;">
            <h2 style="color: #fff; text-align: center; font-size: 28px; margin-bottom: 40px;">Co na EventZone najdeš?</h2>
            
            <div style="display: flex; flex-wrap: wrap; gap: 30px;">
                <div style="flex: 1; min-width: 280px;">
                    <h3 style="color: #deff9a; font-size: 18px; margin-bottom: 10px;">📅 Aktuální kalendář</h3>
                    <p style="color: #888; font-size: 14px; line-height: 1.5; margin: 0;">Všechny plánované akce přehledně na jednom místě. Už ti neuteče žádný koncert ani festival.</p>
                </div>
                <div style="flex: 1; min-width: 280px;">
                    <h3 style="color: #deff9a; font-size: 18px; margin-bottom: 10px;">📍 Prověřená místa</h3>
                    <p style="color: #888; font-size: 14px; line-height: 1.5; margin: 0;">Detailní informace o kapacitách a adresách jednotlivých hal, klubů nebo kulturních domů.</p>
                </div>
                <div style="flex: 1; min-width: 280px;">
                    <h3 style="color: #deff9a; font-size: 18px; margin-bottom: 10px;">🛡️ Bezpečné rezervace</h3>
                    <p style="color: #888; font-size: 14px; line-height: 1.5; margin: 0;">Jedním kliknutím se přihlásíš na akci. Systém hlídá maximální kapacitu za tebe.</p>
                </div>
            </div>
        </div>
    </div>

    <div style="text-align: center; padding: 40px 20px; color: #444; font-size: 13px; border-top: 1px solid #1a1a1a;">
        © 2026 EventZone. Školní projekt pro předmět PWS. Všechna práva vyhrazena.
    </div>

</body>
</html>