<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vytvořit akci | EventZone</title>
</head>
<body style="background-color: #0c0c0c; color: #fff; font-family: sans-serif; margin: 0;">
    <%- include('partials/navbar') %>

    <div style="max-width: 600px; margin: 60px auto; padding: 35px; background: #1a1a1a; border-radius: 12px; border: 1px solid #333; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
        <div style="margin-bottom: 25px;">
            <a href="/events" style="color: #888; text-decoration: none; font-size: 14px; transition: color 0.2s;">← Zpět na seznam akcí</a>
            <h2 style="color: #deff9a; margin-top: 15px; margin-bottom: 0; font-size: 28px; letter-spacing: 1px;">Vytvořit novou akci</h2>
            <p style="color: #666; font-size: 14px; margin-top: 5px;">Naplánujte festival, koncert nebo párty a nahrajte plakát.</p>
        </div>

        <form action="/events/add" method="POST" enctype="multipart/form-data">
            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Název akce</label>
                <input type="text" name="title" placeholder="Např. Summer Music Festival 2026" required 
                       style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
            </div>

            <div style="margin-bottom: 20px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Popis akce</label>
                <textarea name="description" placeholder="Bližší informace o programu, line-upu..." required rows="4"
                          style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px; resize: vertical; font-family: inherit;"></textarea>
            </div>

            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Datum konání</label>
                    <input type="date" name="date" required 
                           style="width: 100%; padding: 11px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
                </div>
                <div style="flex: 1;">
                    <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Maximální kapacita</label>
                    <input type="number" name="maxAttendees" placeholder="Počet míst" required 
                           style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px;">
                </div>
            </div>

            <div style="margin-bottom: 25px;">
                <label style="display: block; margin-bottom: 8px; color: #b0b0b0; font-size: 14px;">Místo konání</label>
                <select name="location" required 
                        style="width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: #fff; box-sizing: border-box; font-size: 15px; cursor: pointer;">
                    <% locations.forEach(loc => { %>
                        <option value="<%= loc._id %>" style="background: #1a1a1a;"><%= loc.name %> (<%= loc.city %>)</option>
                    <% }) %>
                </select>
            </div>

            <div style="margin-bottom: 35px; background: #222; padding: 20px; border-radius: 6px; border: 1px dashed #444; text-align: center;">
                <label style="display: block; margin-bottom: 4px; color: #b0b0b0; font-size: 14px; font-weight: bold;">Plakát akce</label>
                
                <p style="color: #666; font-size: 13px; margin-top: 0; margin-bottom: 15px; line-height: 1.4;">
                    Nahrajte úvodní grafiku nebo plakát, který se zobrazí na hlavní kartě této akce. <br>
                    Podporovány jsou běžné formáty (JPG, PNG).
                </p>
                
                <input type="file" name="image" id="file-upload" accept="image/*" style="display: none;" onchange="updateFileName()">
                
                <label for="file-upload" style="display: inline-block; padding: 10px 20px; background: #2a2a2a; border: 1px solid #555; border-radius: 6px; color: #fff; font-size: 14px; font-weight: bold; cursor: pointer; transition: background 0.2s;">
                    📁 Vybrat obrázek
                </label>
                
                <div id="file-name" style="margin-top: 10px; color: #888; font-size: 13px;">Žádný soubor nevybrán</div>
            </div>

            <button type="submit" style="width: 100%; padding: 14px; background: #deff9a; color: #121212; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 16px; transition: background 0.2s;">
                Publikovat akci
            </button>
        </form>
    </div>

    <script>
        function updateFileName() {
            const input = document.getElementById('file-upload');
            const output = document.getElementById('file-name');
            if (input.files && input.files.length > 0) {
                output.innerText = 'Vybráno: ' + input.files[0].name;
                output.style.color = '#deff9a';
            } else {
                output.innerText = 'Žádný soubor nevybrán';
                output.style.color = '#888';
            }
        }
    </script>
</body>
</html>